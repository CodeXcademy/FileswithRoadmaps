<Page
	x:Class="Files.App.Views.RoadmapPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="using:Files.App.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dataitems="using:Files.App.Data.Items"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">

	<Page.Resources>
		<converters:NullToVisibilityCollapsedConverter x:Key="NullToVisibilityCollapsedConverter" />
	</Page.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Grid Grid.Row="0" Margin="16,16,16,8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<TextBlock
				Grid.Column="0"
				VerticalAlignment="Center"
				FontSize="28"
				FontWeight="SemiBold"
				Text="Roadmap" />

			<StackPanel
				Grid.Column="2"
				Orientation="Horizontal">
				<Button
					Margin="0,0,8,0"
					Padding="12,8"
					Click="CreateRoadmap_Click"
					Style="{StaticResource AccentButtonStyle}">
					<StackPanel Orientation="Horizontal">
						<FontIcon Glyph="&#xE710;" />
						<TextBlock Text="New Roadmap" />
					</StackPanel>
				</Button>
				<Button
					Padding="12,8"
					Click="AddNode_Click">
					<StackPanel Orientation="Horizontal">
						<FontIcon Glyph="&#xE8F4;" />
						<TextBlock Text="Add File/Folder" />
					</StackPanel>
				</Button>
			</StackPanel>
		</Grid>

		<Grid Grid.Row="1" Margin="16,8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="250" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<ListView
				x:Name="RoadmapsList"
				Grid.Column="0"
				Background="Transparent"
				SelectionChanged="RoadmapsList_SelectionChanged">
				<ListView.ItemTemplate>
					<DataTemplate>
						<Grid Margin="4">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<TextBlock
								Grid.Column="0"
								VerticalAlignment="Center"
								Text="{Binding Name}" />
							<Button
								Grid.Column="1"
								Background="Transparent"
								BorderThickness="0"
								Click="DeleteRoadmap_Click"
								Tag="{Binding}">
								<FontIcon Glyph="&#xE74D;" />
							</Button>
						</Grid>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>

			<Border
				Grid.Column="1"
				Margin="16,0,0,0"
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				CornerRadius="{StaticResource ControlCornerRadius}">
				<ScrollViewer
					HorizontalScrollBarVisibility="Auto"
					VerticalScrollBarVisibility="Auto">
					<ItemsControl x:Name="NodesItemsControl" ItemsSource="{x:Bind ViewModel.Nodes, Mode=OneWay}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<Canvas
									MinWidth="1200"
									MinHeight="800"
									Background="Transparent" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemContainerStyle>
							<Style TargetType="ContentPresenter">
								<Setter Property="Canvas.Left" Value="{Binding PositionX}" />
								<Setter Property="Canvas.Top" Value="{Binding PositionY}" />
							</Style>
						</ItemsControl.ItemContainerStyle>
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="dataitems:RoadmapNodeItem">
								<Button
									Width="140"
									Height="120"
									Padding="12"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									AutomationProperties.Name="{x:Bind Text}"
									Click="NodeButton_Click"
									CornerRadius="{StaticResource ControlCornerRadius}"
									PointerPressed="NodeButton_PointerPressed"
									Tag="{Binding}">
									<Button.ContextFlyout>
										<MenuFlyout>
											<MenuFlyoutItem
												Click="OpenNode_Click"
												Text="Open" />
											<MenuFlyoutItem
												Click="OpenInNewTabNode_Click"
												Text="Open in New Tab" />
											<MenuFlyoutItem
												Click="OpenLocationNode_Click"
												Text="Open File Location" />
											<MenuFlyoutSeparator />
											<MenuFlyoutItem
												Click="PropertiesNode_Click"
												Text="Properties" />
											<MenuFlyoutSeparator />
											<MenuFlyoutItem
												Click="RemoveNode_Click"
												Text="Remove from Roadmap" />
										</MenuFlyout>
									</Button.ContextFlyout>
									<StackPanel HorizontalAlignment="Center">
										<Image
											Width="48"
											Height="48"
											Margin="0,0,0,8"
											Source="{Binding Thumbnail, Mode=OneWay}"
											Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibilityCollapsedConverter}}" />
										<FontIcon
											Width="48"
											Height="48"
											Margin="0,0,0,8"
											FontSize="32"
											Glyph="&#xE8B7;"
											Visibility="Collapsed" />
										<TextBlock
											HorizontalAlignment="Center"
											MaxWidth="120"
											Text="{Binding Text}"
											TextAlignment="Center"
											TextTrimming="CharacterEllipsis"
											TextWrapping="Wrap" />
									</StackPanel>
								</Button>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</Border>
		</Grid>
	</Grid>
</Page>
